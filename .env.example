# ============================================================================
#  TensorNest — environment configuration
# ============================================================================
#
#  QUICK START
#    1.  cp .env.example .env         (Windows PowerShell: copy .env.example .env)
#    2.  Generate a JWT secret and paste it into JWT_SECRET below.
#    3.  docker compose up -d --build
#    4.  docker compose exec backend alembic upgrade head
#
#  Copied as-is, this file boots a fully working local stack with no cloud
#  account and no internet: Postgres, Redis, and MinIO standing in for the
#  production object store. Only edit a value if the comment tells you to.
#
#  .env is gitignored. Never commit it, and never paste real credentials into
#  this example file — add a placeholder and describe where to get the value.
#
#  Anything not listed here is still configurable: every field on `Settings`
#  in backend/app/core/config.py can be overridden by its UPPERCASE name.
# ============================================================================


# ----------------------------------------------------------------------------
#  DATABASE                                                          [required]
# ----------------------------------------------------------------------------
#  These three values are the single source of truth for Postgres.
#  docker-compose passes them to the database container AND builds the
#  application's DATABASE_URL from them, so the two can never disagree.
#
#  >> Do NOT add a DATABASE_URL line here. Compose overrides it, and your
#     value would be silently ignored.
#
#  Change these to whatever you like — they only have to be consistent with
#  each other. They differ from developer to developer and that is fine.
#
#  !! If you change them AFTER your first `docker compose up`, you must also
#     run `docker compose down -v`. Postgres only applies these on a fresh,
#     empty data volume, so otherwise you will get login failures that look
#     like a wrong password.
POSTGRES_USER=tensornest
POSTGRES_PASSWORD=localdev
POSTGRES_DB=tensornest


# ----------------------------------------------------------------------------
#  AUTHENTICATION                                                    [required]
# ----------------------------------------------------------------------------
#  Signing key for access and refresh tokens. Any change invalidates every
#  token already issued, which just means everyone logs in again.
#
#  Generate your own — do not ship the placeholder to anything public:
#    macOS / Linux / Git Bash :  openssl rand -hex 32
#    PowerShell               :  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-32-byte-hex-string

# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7


# ----------------------------------------------------------------------------
#  OBJECT STORAGE                                                    [optional]
# ----------------------------------------------------------------------------
#  Where user-uploaded datasets live. Uploads do NOT go on the backend's local
#  disk, because remote GPU providers (Modal) cannot read this machine's
#  filesystem — they can only fetch a dataset over the network.
#
#  TWO MODES:
#
#  (a) LOCAL — leave this whole block commented out.
#      The MinIO container in docker-compose serves the same S3 API on
#      http://localhost:9000, console at http://localhost:9001.
#      Works offline, needs no account. This is the default, and the right
#      choice for day-to-day development.
#
#  (b) CLOUDFLARE R2 — uncomment and fill in. Use this when you need the data
#      to be reachable from outside your machine, e.g. by a training job.
#
#      Getting the values, at dash.cloudflare.com:
#        * S3_ENDPOINT_URL — R2 bucket > Settings > "S3 API". Strip the bucket
#          name off the end; it belongs in S3_BUCKET. The URL you want looks
#          like  https://<account-id>.r2.cloudflarestorage.com  and nothing more.
#        * Key pair — R2 > Manage R2 API Tokens > Create API Token. Choose an
#          *Account* API token (a User token dies if that person leaves the
#          account), permission "Object Read & Write", scoped to one bucket.
#          The secret is displayed exactly once.
#        * S3_REGION must be the literal string "auto" for R2.
#
#      Symptoms of getting it wrong: SignatureDoesNotMatch usually means the
#      region or a mistyped secret; NoSuchBucket usually means the bucket name
#      was left on the end of the endpoint URL.
#
# S3_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# S3_BUCKET=tensornest
# S3_REGION=auto

#  How long a presigned download URL stays valid, in seconds.
# PRESIGNED_URL_TTL_SECONDS=3600


# ----------------------------------------------------------------------------
#  HOST PORTS                                                        [optional]
# ----------------------------------------------------------------------------
#  Only the left-hand side of each mapping — the port on YOUR machine. Change
#  any that collide with something already running locally; a stock Postgres
#  install on 5432 is the usual culprit. Nothing inside the containers moves,
#  so no other value here needs to change with them.
POSTGRES_PORT=5432
REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# ----------------------------------------------------------------------------
#  FRONTEND                                                          [optional]
# ----------------------------------------------------------------------------
#  Read by the browser, not by a container, so it must be a URL your host can
#  reach. If you change BACKEND_PORT above, change the port here to match.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

#  Origins the API accepts cross-origin requests from. JSON array — pydantic
#  parses list fields as JSON, so the brackets and double quotes are required.
CORS_ORIGINS=["http://localhost:3000"]


# ----------------------------------------------------------------------------
#  LOCAL MINIO                                                       [optional]
# ----------------------------------------------------------------------------
#  Credentials for the local MinIO container and its console. Ignored entirely
#  when the R2 block above is uncommented. MinIO refuses to start if the
#  password is shorter than 8 characters.
MINIO_ROOT_USER=tensornest
MINIO_ROOT_PASSWORD=tensornest123


# ----------------------------------------------------------------------------
#  COMPUTE LIMITS                                                    [optional]
# ----------------------------------------------------------------------------
#  Applied to the containers that run user notebooks and training jobs. Raise
#  the memory limits if your machine has room and you are testing larger models.
# DOCKER_NETWORK=tensornest_default
# KERNEL_IMAGE=tensornest-kernel:latest
# KERNEL_IDLE_TIMEOUT_MINUTES=30
# KERNEL_CPU_LIMIT=1.0
# KERNEL_MEMORY_LIMIT=2g
# JOB_CPU_LIMIT=1.0
# JOB_MEMORY_LIMIT=2g
